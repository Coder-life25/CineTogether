# Environment Variables — copy to server/.env and fill in your own values.
# Do NOT put real secrets in this file; .env (which holds them) is gitignored.

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cinetogether?retryWrites=true&w=majority

# Cloudflare R2 (S3-compatible) credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Origin allowed to call the API (the client dev server, or your deployed domain)
CORS_ORIGIN=http://localhost:5173
